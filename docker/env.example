# Nexora — LOCAL Docker dev stack environment variables.
#
# This tool's write permissions block creating files literally named
# `.env*`, so this template is named `env.example` instead of `.env.example`.
# To use it:
#
#   cp docker/env.example .env
#
# ...from the REPO ROOT (docker compose only auto-reads a `.env` file that
# sits next to docker-compose.yml). `.env` is gitignored — never commit real
# secrets into it.
#
# Scope: this file only feeds docker-compose.yml for local development.
# It has no relationship to production (Bluehost/cPanel), which manages its
# own BackEnd/.env by hand on the server.

# --- Postgres (db service) ---
POSTGRES_DB=nexora_db
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora

# --- Backend JWT signing secret ---
# Any random string works for local dev. Do not reuse this value anywhere
# that isn't your own machine.
JWT_SECRET=local_dev_only_change_me_1234567890
